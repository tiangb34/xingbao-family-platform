page{background:#fff9f6;color:#4f4146;font:28rpx -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:28rpx}.hero{margin:-28rpx -28rpx 24rpx;padding:48rpx 32rpx 40rpx;border-radius:0 0 36rpx 36rpx;color:#fff;background:linear-gradient(135deg,#ff8aa5,#ffa77c)}.hero .eyebrow{font-size:24rpx;opacity:.88}.hero .title{display:block;margin-top:10rpx;font-size:44rpx;font-weight:800}.card{margin-bottom:20rpx;padding:24rpx;border:1rpx solid #f0e3e5;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 20rpx #a0667410}.card-title{font-size:32rpx;font-weight:800}.muted{margin-top:10rpx;color:#968388;font-size:26rpx;line-height:1.65}.primary,.secondary,.danger{display:inline-flex;align-items:center;justify-content:center;min-height:72rpx;padding:0 26rpx;border:0;border-radius:18rpx;font-size:28rpx;font-weight:700}.primary{color:#fff;background:linear-gradient(135deg,#ff5d92,#ff8e7d)}.secondary{color:#b55c75;background:#fff0f4}.danger{color:#cf5970;background:#fff0ee}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.input,.textarea,.picker{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx 20rpx;border:1rpx solid #eadde0;border-radius:16rpx;background:#fffaf9;color:#4f4146;font-size:28rpx}.textarea{min-height:170rpx}.tag{display:inline-block;margin-right:8rpx;padding:5rpx 12rpx;border-radius:99rpx;color:#bf6b7f;background:#fff0f3;font-size:22rpx}.empty{padding:52rpx 20rpx;text-align:center;color:#9b878d}.image-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx;margin:18rpx 0}.post-image{width:100%;height:220rpx;border-radius:14rpx}.divider{height:1rpx;margin:18rpx 0;background:#f1e5e6}.fixed-action{position:fixed;right:32rpx;bottom:128rpx;width:98rpx;height:98rpx;border-radius:50%;color:#fff;background:#ff5d92;font-size:48rpx;line-height:98rpx;text-align:center;box-shadow:0 8rpx 20rpx #ff5d9270}
