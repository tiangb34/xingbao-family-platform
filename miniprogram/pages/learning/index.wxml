<view class="page"><view class="hero"><text class="eyebrow">星宝成长小课堂</text><text class="title">把方法变成今天能做的小一步</text></view><view class="categories"><text wx:for="{{categories}}" wx:key="*this" class="category {{active===item?'active':''}}" bindtap="filter" data-value="{{item}}">{{item}}</text></view><view wx:for="{{shown}}" wx:key="id" class="card"><text class="tag">{{item.category}} · {{item.readingTime}}</text><text class="card-title">{{item.icon}} {{item.title}}</text><text class="muted">{{item.intro}}</text><view class="divider"></view><text wx:for="{{item.stepList}}" wx:key="*this" class="step">{{index+1}}. {{item}}</text><text wx:if="{{item.tip}}" class="tip">小提示：{{item.tip}}</text></view></view>
