<view class="page"><view class="card"><input class="input" placeholder="标题" value="{{title}}" bindinput="input" data-key="title"/><textarea class="textarea" maxlength="1000" placeholder="分享你的经历、方法或想问的问题…" value="{{body}}" bindinput="input" data-key="body"/><view class="upload-row"><image wx:for="{{images}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" bindtap="preview" data-url="{{item}}"/><button wx:if="{{images.length < maxImages}}" class="secondary" bindtap="choose">＋ 图片 {{images.length}}/{{maxImages}}</button></view><label class="anonymous"><checkbox checked="{{anonymous}}" bindchange="anonymousChange"/> 匿名发布（自己仍可看到姓名）</label><button class="primary submit" loading="{{submitting}}" bindtap="submit">发布</button></view></view>
