<view class="page"><view wx:if="{{item}}" class="card"><text class="tag">{{item.type}}</text><text class="card-title">{{item.title}}</text><text class="muted">{{item.content}}</text></view><view wx:for="{{sections}}" wx:key="title" class="card"><text class="card-title">{{item.title}}</text><text class="muted">{{item.body}}</text></view><view wx:if="{{item && item.type==='COGNITION'}}"><view wx:for="{{cognition}}" wx:key="id" class="card"><text class="card-title">{{item.title}}</text><text class="muted">{{item.summary}}</text><text class="body">{{item.content}}</text></view></view><view class="notice">内容仅供家庭日常参考，不替代诊断、治疗、法律意见或个体化专业建议。</view></view>
