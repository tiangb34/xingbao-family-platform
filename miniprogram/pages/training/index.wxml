<view class="page"><view wx:if="{{children.length}}"><picker class="picker" range="{{children}}" range-key="nickname" value="{{childIndex}}" bindchange="childChange"><view>当前星宝：{{children[childIndex].nickname}}</view></picker><view class="card"><text class="card-title">新增训练任务</text><input class="input" placeholder="如：睡前收玩具" value="{{newTask.title}}" bindinput="taskInput" data-key="title"/><picker class="picker" range="{{categories}}" value="{{categoryIndex}}" bindchange="categoryChange"><view>分类：{{categories[categoryIndex]}}</view></picker><view class="row"><input class="target" type="digit" value="{{newTask.dailyTarget}}" bindinput="taskInput" data-key="dailyTarget"/><picker class="unit" range="{{units}}" range-key="label" value="{{unitIndex}}" bindchange="unitChange"><view>{{units[unitIndex].label}}</view></picker></view><button class="primary add" bindtap="addTask">添加任务</button></view><view class="section-title">今日任务</view><view wx:for="{{tasks}}" wx:key="id" class="card"><text class="card-title">{{item.title}}</text><text class="muted">{{item.category}} · 每天 {{item.dailyTarget}} {{item.dailyUnit==='HOUR'?'小时':'天'}}</text><view class="result-row"><button class="{{item.todayResult==='DONE'?'selected':''}}" bindtap="record" data-id="{{item.id}}" data-result="DONE">完成</button><button class="{{item.todayResult==='ASSISTED'?'selected':''}}" bindtap="record" data-id="{{item.id}}" data-result="ASSISTED">需协助</button><button class="{{item.todayResult==='MISSED'?'selected':''}}" bindtap="record" data-id="{{item.id}}" data-result="MISSED">未完成</button><button class="end" bindtap="end" data-id="{{item.id}}">结束</button></view></view><view class="section-title">近 7 天使用趋势</view><view class="card"><view wx:for="{{trend.days}}" wx:key="date" class="trend"><text>{{item.date}}</text><view class="bar"><view style="width:{{item.width}}%"></view></view><text>{{item.done}}/{{item.total}}</text></view></view><view class="section-title">我的视觉提示卡</view><view class="card"><input class="input" placeholder="提示语，如：先洗手" value="{{cueTitle}}" bindinput="cueInput"/><button class="secondary add" bindtap="addCue">新增提示卡</button></view><view class="cue-grid"><view wx:for="{{cues}}" wx:key="id" class="cue" style="background:{{item.color}}" bindtap="speak" data-text="{{item.title}}" bindlongpress="deleteCue" data-id="{{item.id}}"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}"/><text>{{item.title}}</text></view></view></view><view wx:else class="empty">请先创建星宝档案后再制定训练任务。</view></view>
