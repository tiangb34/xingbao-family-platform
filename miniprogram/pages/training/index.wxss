.target{flex:1;padding:18rpx;border:1rpx solid #eadde0;border-radius:16rpx}.unit{width:150rpx;padding:18rpx;border:1rpx solid #eadde0;border-radius:16rpx;background:#fff}.add{margin-top:18rpx}.section-title{margin:30rpx 0 16rpx;font-size:34rpx;font-weight:800}.result-row{display:flex;gap:10rpx;margin-top:16rpx}.result-row button{padding:10rpx 13rpx;border:0;border-radius:12rpx;color:#856f76;background:#fff0f3;font-size:23rpx}.result-row button.selected{color:#fff;background:#ff6f98}.result-row .end{margin-left:auto;color:#b27071;background:#fff5ef}.trend{display:grid;grid-template-columns:120rpx 1fr 74rpx;align-items:center;gap:12rpx;margin:13rpx 0;color:#7f6971;font-size:22rpx}.bar{height:14rpx;overflow:hidden;border-radius:99rpx;background:#f2e8ea}.bar view{height:100%;border-radius:99rpx;background:#ff759b}.cue-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.cue{display:flex;flex-direction:column;justify-content:flex-end;min-height:150rpx;padding:20rpx;border-radius:20rpx;font-weight:800}.cue image{width:100%;height:88rpx;margin-bottom:10rpx;border-radius:10rpx}
