<view class="page"><view wx:for="{{posts}}" wx:key="id" class="card post" bindtap="detail" data-id="{{item.id}}"><view wx:if="{{item.images.length}}" class="image-grid"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" class="post-image" src="{{image}}" mode="aspectFill" bindtap="preview" data-images="{{item.images}}" data-url="{{image}}"/></view><text class="card-title">{{item.title}}</text><text class="muted">{{item.body}}</text><view class="divider"></view><view class="row"><text class="author">{{item.anonymous ? '匿名家长' : item.authorName}} · {{item.time}}</text><view><text class="action" catchtap="like" data-id="{{item.id}}">{{item.liked ? '♥' : '♡'}} {{item.likes}}</text><text class="action"> ◌ {{item.comments}}</text></view></view></view><view wx:if="{{!posts.length && !loading}}" class="empty">还没有公开帖子，来分享第一条吧。</view><button wx:if="{{hasMore}}" class="secondary more" bindtap="loadMore">查看更多帖子 ＞＞</button><view class="fixed-action" bindtap="publish">＋</view></view>
