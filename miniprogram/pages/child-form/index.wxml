<view class="page"><view class="card"><input class="input" placeholder="孩子昵称" value="{{form.nickname}}" bindinput="input" data-key="nickname"/><picker class="picker" range="{{genders}}" range-key="name" value="{{genderIndex}}" bindchange="gender"><view>性别：{{genders[genderIndex].name}}</view></picker><picker mode="date" class="picker" value="{{form.birthday}}" bindchange="birthday"><view>出生日期：{{form.birthday || '请选择'}}</view></picker><input class="input" placeholder="干预年限（可选）" value="{{form.interventionYears}}" bindinput="input" data-key="interventionYears"/><button class="primary save" bindtap="save">保存档案</button></view></view>
