<view class="page"><view wx:if="{{user}}" class="hero"><text class="eyebrow">已登录用户</text><text class="title">{{user.nickname}}</text><text class="sub">{{user.phone}}</text></view><view wx:else class="hero"><text class="title">欢迎来到星宝家庭互助</text></view><view wx:if="{{user}}" class="card"><text class="card-title">我的消息</text><view wx:for="{{messages}}" wx:key="id" class="divider message"><text>{{item.body}}</text></view><text wx:if="{{!messages.length}}" class="muted">暂无消息</text></view><button wx:if="{{user}}" class="secondary" bindtap="logout">退出登录</button><button wx:else class="primary" bindtap="login">登录或注册</button></view>
