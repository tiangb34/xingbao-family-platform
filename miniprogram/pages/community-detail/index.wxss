.section-title{margin:30rpx 0 18rpx;font-size:34rpx;font-weight:800}.comment-send{display:flex;gap:12rpx}.comment-input{flex:1;min-width:0;padding:16rpx;border-radius:18rpx;background:#fff;border:1rpx solid #efdfe3}.send{padding:0 22rpx;border:0;border-radius:16rpx;color:#fff;background:#ff6b95}.anonymous{display:block;margin:14rpx 0;color:#887279;font-size:24rpx}.comment{margin-bottom:12rpx}.comment-name{font-weight:800}.pending{padding:3rpx 8rpx;border-radius:8rpx;color:#be7c17;background:#fff2ca;font-size:20rpx}.text-danger{padding:5rpx;border:0;color:#ce6475;background:transparent;font-size:24rpx}.delete{margin-top:18rpx}
