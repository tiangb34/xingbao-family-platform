<view class="page" wx:if="{{post}}"><view class="card"><view wx:if="{{images.length}}" class="image-grid"><image wx:for="{{images}}" wx:key="*this" class="post-image" src="{{item}}" mode="aspectFill" bindtap="preview" data-url="{{item}}"/></view><text class="card-title">{{post.title}}</text><text class="muted">{{post.body}}</text><view class="divider"></view><view class="row"><text class="author">{{author}} · {{time}}</text><view><text class="action" bindtap="like">{{liked?'♥':'♡'}} 点赞 {{likes}}</text></view></view><button wx:if="{{isOwner && permissions.allowPostDelete}}" class="danger delete" bindtap="remove">删除帖子</button></view><view class="section-title">评论 {{publicCount}}</view><view class="comment-send"><input class="comment-input" placeholder="友善地说点什么…" value="{{comment}}" bindinput="commentInput"/><button class="send" bindtap="sendComment">发送</button></view><label class="anonymous"><checkbox checked="{{anonymous}}" bindchange="anonymousChange"/> 匿名评论</label><view wx:for="{{comments}}" wx:key="id" class="card comment"><view class="row"><text class="comment-name">{{item.isAuthor?'作 ':''}}{{item.name}} <text wx:if="{{item.status==='PENDING'}}" class="pending">待审</text></text><button wx:if="{{item.own && permissions.allowCommentDelete}}" class="text-danger" bindtap="deleteComment" data-id="{{item.id}}">删除</button></view><text class="muted">{{item.body}}</text></view><button wx:if="{{hasMoreComments}}" class="secondary more" bindtap="moreComments">查看更多评论 ＞＞</button></view>
